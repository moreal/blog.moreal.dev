---
import "../ui/admin.css";

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title} · CMS</title>
  </head>
  <body>
    <nav class="topbar">
      <a href="/admin">글</a>
      <a href="/admin/new">새 글</a>
      <a href="/admin/ime-test">IME 검증</a>
      <span class="grow"></span>
      <a href="/" target="_blank">사이트 보기</a>
    </nav>
    <slot />
  </body>
</html>
